{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@console/types": ["./packages/types/src/index.ts"],
      "@console/utils": ["./packages/utils/src/index.ts"],
      "@console/api": ["./packages/api/src/index.ts"],
      "@/*": ["./apps/server/*"]
    }
  },
  "exclude": ["node_modules", "**/dist", "apps/mobile"]
}
