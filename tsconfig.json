{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@console/types": ["./packages/types/src/index.ts"],
      "@console/api": ["./packages/api/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "**/dist"]
}
