{
  "name": "console-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A coding agent engine monorepo with CLI, Server, Desktop and shared API package",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/cli"
  ],
  "scripts": {
    "dev:server": "bun --watch apps/server/index.ts",
    "start:server": "bun apps/server/index.ts",
    "dev:desktop": "cargo run --manifest-path apps/desktop/Cargo.toml",
    "build:desktop": "cargo build --release --manifest-path apps/desktop/Cargo.toml",
    "build:desktop:mac": "cargo build --release --manifest-path apps/desktop/Cargo.toml",
    "cli": "bun apps/cli/index.ts",
    "check": "vp check",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.1.1",
    "typescript": "~5.9.2"
  }
}
