{
  "name": "console-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A coding agent engine monorepo with CLI, Server, Mobile, Desktop and shared API package",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@console/server",
    "start:server": "npm run start --workspace=@console/server",
    "dev:mobile": "npm run android --workspace=@console/mobile",
    "icons:generate": "npm run icons:generate --workspace=@console/mobile",
    "theme:generate": "npm run theme:generate --workspace=@console/mobile",
    "dev:desktop": "npm run dev --workspace=@console/desktop",
    "build:desktop": "npm run build --workspace=@console/desktop",
    "build:desktop:mac": "npm run build:mac --workspace=@console/desktop",
    "cli": "npm run cli --workspace=@console/cli",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "curl -fsSL https://bun.sh/install | bash -s \"canary\" && (cp -f ~/.bun/bin/bun $(which bun) 2>/dev/null || cp -f ~/.bun/bin/bun /usr/local/bin/bun 2>/dev/null || true)"
  },
  "dependencies": {
    "@console/desktop": "^1.0.0",
    "metro-runtime": "^0.87.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-worklets": "~0.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "expo": "~54.0.0",
    "expo-router": "~6.0.23",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@types/react": "19.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-safe-area-context": "~5.6.0"
  }
}
