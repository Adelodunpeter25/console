[
  {"label": "desktop to file", "tool": "get_desktop_state",
   "args": {"screenshot_out_file": "/tmp/cua-desktop.png"}, "as": "desk"},
  {"label": "launch calculator", "tool": "launch_app",
   "args": {"bundle_id": "com.apple.calculator"}, "as": "launch"},
  {"label": "wait for window", "tool": "$wait_window",
   "args": {"pid": "{{launch.pid}}", "timeout_ms": 15000}, "as": "win"},
  {"label": "window to file", "tool": "get_window_state",
   "args": {"pid": "{{launch.pid}}", "window_id": "{{win.window_id}}",
            "screenshot_out_file": "/tmp/cua-calc.png",
            "include_screenshot": false}, "as": "calcshot"}
]
