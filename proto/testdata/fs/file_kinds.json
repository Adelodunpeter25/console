{
  "lock_basenames": ["package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml", "composer.lock"],
  "lock_suffixes": [".lock", ".lockb"],
  "raster_image_extensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".ico"],
  "blocked_extensions": [
    ".mp4", ".mov", ".avi", ".mkv", ".webm", ".mp3", ".wav", ".flac", ".ogg", ".m4a",
    ".zip", ".tar", ".gz", ".tgz", ".bz2", ".xz", ".7z", ".rar", ".jar", ".war",
    ".exe", ".dll", ".so", ".dylib", ".a", ".o", ".obj", ".bin", ".iso", ".dmg", ".pkg", ".deb",
    ".rpm", ".apk", ".ipa", ".node",
    ".ttf", ".otf", ".woff", ".woff2", ".eot",
    ".pdf", ".wasm", ".psd", ".sketch", ".class", ".pyc", ".db", ".sqlite", ".sqlite3", ".icns",
    ".tiff"
  ]
}
