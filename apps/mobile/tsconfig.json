{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@console/api": [
        "../../packages/api/src"
      ],
      "@console/types": [
        "../../packages/types/src"
      ]
    },
    "jsx": "react-native",
    "lib": [
      "dom",
      "esnext"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}